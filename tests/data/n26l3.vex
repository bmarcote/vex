VEX_rev = 1.5;
*    pySCHED version: 1.29.0
*    SCHED version:   Release 12.0; March 2025
*    VEX/SCHED:       1.5.5
*    Other versions: Sched:  12.0 JPL-ephem: 1.01
*    Catalog versions:
*       Frequency: 2026Jun05-13:46:00
*       Station:   2026Jul21-13:16:08
*       Location:  2020Jan12
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = N26L3;
*                                                      +------------+
*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       vlbi
*------------------------------------------------------------------------------
$EXPER;
*
def N26L3;
     exper_name = N26L3;
     exper_description = "Network Monitoring Experiment";
     PI_name = marcote;
     PI_email = marcote@jive.eu;
*    address:   Oude Hoogeveensedijk 3
*               7991PD Dwingeloo
*               The Netherlands
*               
*    phone:     +31 521 596 530
*    during obs:+31 521 596 530
*    fax:       
*    L-band (18cm) NME and ftp fringe test for Session 3, 2026.
*    1024 Mbps, L+R, 2-bit sampling, 8 BBC, 32 MHz filters
*    Please DO NOT use the phase cal signal.
*
*    year, doy: 2026, 303
*    date     : Fri 30 Oct 2026
*    MJD      : 61343
     exper_nominal_start=2026y303d09h00m00s;
     exper_nominal_stop=2026y303d12h00m00s;
*
*-------------------- cover  letter --------------------
*
*This is the schedule for the 18cm NME and ftp fringe-test on 30 October 2026
*involving 16 antennas:
*Jb2, Wb, Ef, Mc, Nt, O8, T6, Ur, Tr, Hh, Ir, Cm, Kn, Pi, Da, De
*
*The following ftp-fringe tests are scheduled throughout the experiment (UT times):
*
*09:10:00 (scan  2, 2 sec, J1613+3412)
*09:40:00 (scan  4, 2 sec, J1613+3412)
*10:10:00 (scan  6, 2 sec, J1613+3412)
*10:40:00 (scan  8, 2 sec, J1613+3412)
*11:10:00 (scan 10, 2 sec, J1613+3412)
*11:40:00 (scan 12, 2 sec, J1613+3412)
*
*------------------------- end -------------------------
*
     target_correlator = JIVE;
*
*    integr_time    : 1.0 s
*    number_channels: 64
*    number_antenna : 16
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  :
*                     N/A
*                     
*                     
*                     
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def evn18cm-1Gbps-16MHz;
     ref $PROCEDURES = Procedure:Jb:Wb:Ef:Mc:Nt:O8:T6:Ur:Tr:Hh:Ir:Cm:Kn:Pi:Da:De;
     ref $IF = LO@1100MHzDPolNoTone:Ur;
     ref $IF = LO@1247MHzDPolNoTone:Wb;
     ref $IF = LO@1279MHzDPolNoTone:Nt;
     ref $IF = LO@1295MHzDPolNoTone:Mc;
     ref $IF = LO@1350MHzDPolNoTone:Ir;
     ref $IF = LO@1510MHzDPolNoTone:Ef;
     ref $IF = LO@1510MHzDPolNoTone#02:Hh;
     ref $IF = LO@2270MHzDPolNoTone:T6;
     ref $IF = LO@2272MHzDPolNoTone:Cm:Da:De:Kn:Pi;
     ref $IF = LO@2272MHzDPolNoTone#02:Jb;
     ref $IF = LO@2300MHzDPolNoTone:Tr;
     ref $IF = LO@730MHzDPolNoTone:O8;
     ref $BBC = 2BBCs:Cm:Da:De:Kn:Pi;
     ref $BBC = 8BBCs:Ef;
     ref $BBC = 8BBCs#02:Hh:Mc:O8;
     ref $BBC = 8BBCs#03:Ir;
     ref $BBC = 8BBCs#04:Jb;
     ref $BBC = 8BBCs#05:Nt;
     ref $BBC = 8BBCs#06:T6;
     ref $BBC = 8BBCs#07:Tr:Wb;
     ref $BBC = 8BBCs#08:Ur;
     ref $PHASE_CAL_DETECT = NoDetect:Cm:Da:De:Ef:Hh:Ir:Jb:Kn:Mc:Nt:O8:Pi:T6:Tr:Ur:Wb;
     ref $FREQ = 1610.49MHz16x16MHz:Ef:Hh:Ir:Jb:Mc:Nt:O8:Tr:Ur:Wb;
     ref $FREQ = 1610.49MHz16x16MHz#02:T6;
     ref $FREQ = 1626.49MHz2x64MHz:Cm:Da:De:Kn:Pi;
     ref $TRACKS = VDIF5032.2Ch2bit1to1:Cm:Da:De:Kn:Pi;
     ref $TRACKS = VDIF8032.16Ch2bit1to1:Ef:Hh:Ir:Jb:Mc:Nt:O8:T6:Tr:Ur:Wb;
     ref $ROLL = NoRoll:Cm:Da:De:Ef:Hh:Ir:Jb:Kn:Mc:Nt:O8:Pi:T6:Tr:Ur:Wb;
enddef;
