$ANTENNA;
*
def CAMBG32M;
     axis_type = az : el;
     antenna_motion = az :   40.0 deg/min : 2 sec;
     antenna_motion = el :   20.0 deg/min : 2 sec;
     pointing_sector = &ccw : az : 270.0 deg : 325.0 deg : el : 2.0 deg : 89.0 deg;
     pointing_sector =   &n : az : 325.0 deg : 630.0 deg : el : 2.0 deg : 89.0 deg;
     pointing_sector =  &cw : az : 630.0 deg : 685.0 deg : el : 2.0 deg : 89.0 deg;
     axis_offset =      1.503 m;
enddef;
*
def DEFFORD;
     axis_type = az : el;
