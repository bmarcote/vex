VEX_rev = 1.5;
*    pySCHED version: 1.29.0
*    SCHED version:   Release 12.0; March 2025
*    VEX/SCHED:       1.5.5
*    Other versions: Sched:  12.0 JPL-ephem: 1.01
*    Catalog versions:
*       Frequency: 2026Jun05-13:46:00
*       Station:   2026Jul21-13:16:08
*       Location:  2020Jan12
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = N26K3;
*                                                      +------------+
*                         PI revision number:          |    2.0000  |
*                                                      +------------+
*    mode:       vlbi
*------------------------------------------------------------------------------
$EXPER;
*
def N26K3;
     exper_name = N26K3;
     exper_description = "Network Monitoring Experiment";
     PI_name = "Miriam Nyamai";
     PI_email = nyamai@jive.eu;
*    address:   JIVE
*               Oude Hoogeveensedijk 4
*               Dwingeloo
*               Netherlands
*    phone:     +31 521 596 508
*    during obs:+31 52i1 596 508
*    fax:       
*    K-band (1.3cm) NME and ftp fringe test for Session 3, 2026.
*    EVN: 4 Gbps, 16 IFs, 32 MHz filters, L+R, 2-bit sampling
*    MER: 512Mbps/2IF/64MHz
*    Please DO NOT use the phase cal signal.
*
*    year, doy: 2026, 289
*    date     : Fri 16 Oct 2026
*    MJD      : 61329
     exper_nominal_start=2026y289d09h00m00s;
     exper_nominal_stop=2026y289d12h00m00s;
*
*-------------------- cover  letter --------------------
*
*    This is the schedule for the 1.3cm NME and ftp fringe test on 16 October 2026
*    involving 12 EVN antennas + eMERLIN + VERA:
*    Jb2, Ef, Mc, O6, T6, Ur, Tr, Mh, Hh, Kt, Ku, Kc, Cm, Da, Pi, Kn.
*
*    The NME uses a standard setup with a datarate of 4 Gbps,
*    with Ur at 2 Gbps, and eMERLIN at 512 Mbps.
*
*    The NME lasts for 3 hours and consists of long scans on calibrators:
*    J1619+2247 and J1613+3412.
*
*    with 2- or 4-s ftp grabs every other scan at the following times (in UT):
*    09:13:00 (scan  2, 4 sec, J1619+2247)
*    09:43:00 (scan  4, 4 sec, J1550+0527)
*    10:13:00 (scan  6, 2 sec, J1550+0527)
*    10:43:00 (scan  8, 4 sec, 3C345)
*    11:13:00 (scan 10, 2 sec, 3C345)
*    11:43:00 (scan 12, 2 sec, 3C345)
*
*    Note that scans 2, 4 and scan 8 will have a 4-s grab instead (to guarantee enough SNR).
*
*
*    Miriam Nyamai
*    Mattermost: coms.evlbi.org
*
*------------------------- end -------------------------
*
     target_correlator = JIVE;
*
*    integr_time    : 2.0 s
*    number_channels: 32
*    number_antenna : 16
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  :
*                     N/A
*                     
*                     
*                     
*    The last NME to end the year at the highest frequencies
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def evn1cm-4Gbps-32MHz;
     ref $PROCEDURES = Procedure:Jb:Ef:Mc:O6:T6:Ur:Tr:Mh:Hh:Kt:Ku:Kc:Cm:Da:Pi:Kn;
     ref $IF = LO@21480MHzDPolNoTone:Ef;
     ref $IF = LO@21480MHzDPolNoTone#02:Hh;
     ref $IF = LO@21480MHzDPolNoTone#03:Mh:Tr;
     ref $IF = LO@21480MHzDPolNoTone#04:O6;
     ref $IF = LO@21480MHzDPolNoTone#05:T6;
     ref $IF = LO@21992MHzDPolNoTone:Mc;
     ref $IF = LO@21992MHzDPolNoTone#02:Ur;
     ref $IF = LO@23016MHzDPolNoTone:Cm:Da:Kn:Pi;
     ref $IF = LO@23016MHzDPolNoTone#02:Jb;
     ref $IF = LO@34000MHzDPolNoTone:Kt:Ku;
     ref $IF = LO@34110MHzDPolNoTone:Kc;
     ref $BBC = 16BBCs:Ef;
     ref $BBC = 16BBCs#02:Hh;
     ref $BBC = 16BBCs#03:Jb;
     ref $BBC = 16BBCs#04:Mc:O6;
     ref $BBC = 16BBCs#05:Mh:Tr;
     ref $BBC = 16BBCs#06:T6;
     ref $BBC = 2BBCs:Cm:Da:Kn:Pi;
     ref $BBC = 2BBCs#02:Kc:Kt:Ku;
     ref $BBC = 8BBCs:Ur;
     ref $PHASE_CAL_DETECT = NoDetect:Cm:Da:Ef:Hh:Jb:Kc:Kn:Kt:Ku:Mc:Mh:O6:Pi:T6:Tr:Ur;
     ref $FREQ = 22024MHz32x32MHz:Ef:Hh:Jb:Mc:Mh:O6:T6:Tr;
     ref $FREQ = 22056MHz16x64MHz:Kc:Kt:Ku;
     ref $FREQ = 22216MHz16x32MHz:Ur;
     ref $FREQ = 22248MHz2x64MHz:Cm:Da:Kn:Pi;
     ref $TRACKS = VDIF5032.16Ch2bit1to1:Kc:Kt:Ku;
     ref $TRACKS = VDIF5032.2Ch2bit1to1:Cm:Da:Kn:Pi;
     ref $TRACKS = VDIF8032.16Ch2bit1to1:Ur;
     ref $TRACKS = VDIF8032.32Ch2bit1to1:Ef:Hh:Jb:Mc:Mh:O6:T6:Tr;
     ref $ROLL = NoRoll:Cm:Da:Ef:Hh:Jb:Kc:Kn:Kt:Ku:Mc:Mh:O6:Pi:T6:Tr:Ur;
enddef;
