*       Station:   2026Jul21-13:16:08
*       Location:  2020Jan12
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = N26C3;
*                                                      +------------+
*                         PI revision number:          |    1.0000  |
*                                                      +------------+
*    mode:       vlbi
*------------------------------------------------------------------------------
$EXPER;
*
def N26C3;
     exper_name = N26C3;
     exper_description = "Network Monitoring Experiment";
     PI_name = marcote;
     PI_email = marcote@jive.eu;
*    address:   Oude Hoogeveensedijk 3
*               7991PD Dwingeloo
*               The Netherlands
*               
*    phone:     +31 521 596 530
*    during obs:+31 521 596 530
*    fax:       
*    C-band (6cm) NME and ftp fringe test for Session 3, 2026.
*    4096 Mbps, L+R, 2-bit sampling, 32 BBC, 32 MHz filters
*    Please DO NOT use the phase cal signal.
*
*    year, doy: 2026, 293
*    date     : Tue 20 Oct 2026
*    MJD      : 61333
     exper_nominal_start=2026y293d11h00m00s;
     exper_nominal_stop=2026y293d14h00m00s;
*
*-------------------- cover  letter --------------------
*
*This is the schedule for the 6cm NME and ftp fringe-test on 20 October 2026
*involving 15 antennas:
*Jb2, Wb, Ef, Mc, O8, T6, Ur, Tr, Hh, Ir, Cm, Da, De, Kn, Pi
*
*The following ftp-fringe tests are scheduled throughout the experiment (UT times):
*
*11:10:00 (scan  2, 2 sec, J1753+2848)
*11:40:00 (scan  4, 2 sec, J1753+2848)
*12:10:00 (scan  6, 2 sec, J1753+2848)
*12:40:00 (scan  8, 2 sec, J1753+2848)
*13:10:00 (scan 10, 2 sec, J1753+2848)
*13:40:00 (scan 12, 2 sec, J1753+2848)
*
*------------------------- end -------------------------
*
     target_correlator = JIVE;
*
*    integr_time    : 1.0 s
*    number_channels: 8
*    number_antenna : 15
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  :
*                     N/A
*                     
*                     
*                     
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def evn6cm-4Gbps-32MHz;
     ref $PROCEDURES = Procedure:Jb:Wb:Ef:Mc:O8:T6:Ur:Tr:Hh:Ir:Cm:Kn:Pi:Da:De;
     ref $IF = LO@4088MHzDPolNoTone:Ef;
     ref $IF = LO@4088MHzDPolNoTone#02:Ir:O8;
     ref $IF = LO@4088MHzDPolNoTone#03:T6;
     ref $IF = LO@4088MHzDPolNoTone#04:Tr;
     ref $IF = LO@4344MHzDPolNoTone:Mc;
     ref $IF = LO@4517MHzDPolNoTone:Wb;
     ref $IF = LO@4600MHzDPolNoTone:Hh;
     ref $IF = LO@4600MHzDPolNoTone#02:Ur;
     ref $IF = LO@5624MHzDPolNoTone:Cm:Da:De:Kn:Pi;
     ref $IF = LO@5624MHzDPolNoTone#02:Jb;
     ref $BBC = 16BBCs:Ef;
     ref $BBC = 16BBCs#02:Hh;
     ref $BBC = 16BBCs#03:Ir:Mc:O8;
     ref $BBC = 16BBCs#04:Jb;
     ref $BBC = 16BBCs#05:T6;
     ref $BBC = 16BBCs#06:Tr;
     ref $BBC = 16BBCs#07:Ur;
     ref $BBC = 2BBCs:Cm:Da:De:Kn:Pi;
     ref $BBC = 4BBCs:Wb;
     ref $PHASE_CAL_DETECT = NoDetect:Cm:Da:De:Ef:Hh:Ir:Jb:Kn:Mc:O8:Pi:T6:Tr:Ur:Wb;
     ref $FREQ = 4632MHz32x32MHz:Ef:Hh:Ir:Jb:Mc:O8:T6:Tr:Ur;
     ref $FREQ = 4888MHz2x64MHz:Cm:Da:De:Kn:Pi;
     ref $FREQ = 4888MHz8x32MHz:Wb;
     ref $TRACKS = VDIF5032.2Ch2bit1to1:Cm:Da:De:Kn:Pi;
     ref $TRACKS = VDIF8032.32Ch2bit1to1:Ef:Hh:Ir:Jb:Mc:O8:T6:Tr:Ur;
     ref $TRACKS = VDIF8032.8Ch2bit1to1:Wb;
